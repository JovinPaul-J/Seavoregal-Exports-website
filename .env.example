# Seavoregal Exports - Environment Configuration Example

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://seavoregalexports.com
NEXT_PUBLIC_SITE_NAME=Seavoregal Exports

# MongoDB Configuration (Required - for product management)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/seavoregal?retryWrites=true&w=majority

# Admin Panel Configuration
ADMIN_PASSWORD=seavoregal-admin-2024
ADMIN_TOKEN_SECRET=your-secret-key-change-this-in-production

# Email Configuration (optional - for sending inquiries)
# RESEND_API_KEY=your_resend_api_key_here
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SMTP_HOST=your_smtp_host
# SMTP_PORT=your_smtp_port
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Contact Email
CONTACT_EMAIL=akshykeerthan@gmail.com,

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your_domain

# WhatsApp Business API (optional - for WhatsApp integration)
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id
# WHATSAPP_BUSINESS_PHONE_ID=your_phone_id
# WHATSAPP_BUSINESS_API_TOKEN=your_api_token

# Node Environment
NODE_ENV=production
